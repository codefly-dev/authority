# The directory page's slots, as this composition fills them: both stores are
# reached through the hop in front of them, which routes each call by its Work
# Context's audience; the bindings are the ones the directory's contract asks for.
RECORDS_ENDPOINT=${endpoint:authority/hop/grpc}
RECORDS_AUDIENCE=records
RECORDS_TYPES_BINDING=records-types
DOCUMENTS_ENDPOINT=${endpoint:authority/hop/grpc}
DOCUMENTS_AUDIENCE=documents
DOCUMENTS_WRITE_BINDING=documents-write
DOCUMENTS_READ_BINDING=documents-read
