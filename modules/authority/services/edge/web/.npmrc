# @codefly-dev/ui, the platform's UI kit, ships from GitHub Packages, not npmjs.
# Only that scope is redirected. The read token is supplied at install time as
# NODE_AUTH_TOKEN (read:packages) and is never committed.
@codefly-dev:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
