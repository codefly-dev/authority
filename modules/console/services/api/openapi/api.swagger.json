          }
        },
        "tags": [
          "ApiService"
        ]
      }
    },
    "/whoami": {
      "get": {
        "summary": "WhoAmI answers who the call is for. A call that did not come through the\nhop is refused before it reaches this method, and the hop lets through\nonly a caller who holds console.identity read.",
        "operationId": "ApiService_WhoAmI",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/apiWhoAmIResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "ApiService"
        ]
      }
    }
  },
  "definitions": {
    "apiVersionResponse": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        }
      }
    },
    "apiWhoAmIResponse": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "description": "The person, installation or workload the call acts for."
        },
        "ownerKind": {
          "type": "string",
          "description": "What kind of principal the owner is."
        },
        "tenant": {
          "type": "string",
          "description": "The organisation the call runs in."
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The modules acting for the owner, in order."
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What the call may do, each \"\u003cresource kind\u003e:\u003caction\u003e\"."
        }
      },
      "description": "WhoAmIResponse is who the call is for, as the hop in front of the console\nstamped it after the authority checked the caller's Work Context. The console\nverifies no token: it answers from the stamp alone."
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    }
